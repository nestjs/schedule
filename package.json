{
  "name": "@nestjs/schedule",
  "version": "12.0.3",
  "description": "Scheduled jobs for NestJS: cron jobs, intervals and timeouts as decorators on provider methods, which can also be created and stopped at runtime.",
  "keywords": [
    "nestjs",
    "nest",
    "cron",
    "cron-jobs",
    "scheduler",
    "task-scheduling",
    "scheduled-tasks",
    "interval"
  ],
  "author": "Kamil Mysliwiec",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "url": "https://github.com/nestjs/schedule#readme",
  "scripts": {
    "build": "rimraf -rf dist && tsc -p tsconfig.json",
    "format": "prettier **/**/*.ts --ignore-path ./.prettierignore --write",
    "lint": "oxlint lib/",
    "prepublish:npm": "npm run build",
    "publish:npm": "npm publish --access public",
    "prepublish:next": "npm run build",
    "publish:next": "npm publish --access public --tag next",
    "test:integration": "vitest run",
    "prerelease": "npm run build",
    "release": "release-it"
  },
  "dependencies": {
    "cron": "4.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-angular": "21.2.4",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/testing": "12.4.2",
    "@types/node": "26.6.6",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxlint": "1.93.0",
    "prettier": "3.10.1",
    "reflect-metadata": "0.2.2",
    "release-it": "21.1.2",
    "rimraf": "6.1.4",
    "rxjs": "7.8.2",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nestjs/schedule"
  }
}
